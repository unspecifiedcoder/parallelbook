# LiveMarkets — copy to .env and fill in what you need.
#
# The web app runs with NONE of this set: it reads live state straight from a
# public RPC and shows a designed empty state if the factory is unreachable.
# Each section below unlocks one more thing.

# ---------------------------------------------------------------------------
# chain (optional — defaults are public endpoints)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_WS_URL=
NEXT_PUBLIC_MONAD_EXPLORER=https://testnet.monadexplorer.com
# Multicall3 on Monad testnet. Set this and every page read becomes one request.
NEXT_PUBLIC_MULTICALL3=

# Server-side RPC for the cranker, indexer and benchmark. A private endpoint is
# worth it here — these processes are chatty.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Used by forge via foundry.toml's rpc_endpoints.
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# ---------------------------------------------------------------------------
# wallets (optional — without it the app is read-only, which is a valid demo)
# ---------------------------------------------------------------------------
# From dashboard.privy.io. Enables email / social login and embedded wallets.
# Leave blank and the app falls back to injected-wallet-only, still fully usable.
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------------------
# deployment (needed for `npm run deploy`)
# ---------------------------------------------------------------------------
# NEVER a key with real funds. Testnet only.
DEPLOYER_PRIVATE_KEY=
# Where protocol fees go. Defaults to the deployer.
FEE_RECIPIENT=
# Who can call resolve(). This is the honest centralisation in v1 — see the
# roadmap in apps/web/config/contracts.ts. Defaults to the deployer.
RESOLVER_ADDRESS=
# Round shape. 45s of trading, settle from 60s.
OPEN_SECONDS=45
ROUND_SECONDS=60
# 1% fee on winnings, 10% of that to whoever cranked the tick. Void charges zero.
FEE_BPS=100
CRANK_SHARE_BPS=1000
# Semicolon-separated questions, one Series each.
SERIES_QUESTIONS=Boundary this over?;Does the CT side win this round?;Next block above 2M gas?

# ---------------------------------------------------------------------------
# bots (needed for `npm run crank`)
# ---------------------------------------------------------------------------
# Three separate keys on purpose: a leaked cranker key costs pennies of gas, not
# the ability to settle a market you are trading.
CRANK_PRIVATE_KEY=
# Optional. Quotes both legs so a fresh round is never an empty book.
MAKER_PRIVATE_KEY=
# Optional. Only settles questions derivable from chain data; everything else
# waits for a human at /admin.
RESOLVER_PRIVATE_KEY=

CRANK_INTERVAL_MS=600
HOUSE_MAKER=on
MAKER_SPREAD_BPS=500
MAKER_SIZE_WEI=2000000000000000000
MAKER_MAX_ROUND_WEI=10000000000000000000
MAKER_MAX_DAILY_LOSS_WEI=50000000000000000000

# ---------------------------------------------------------------------------
# benchmark (needed for `npm run bench`)
# ---------------------------------------------------------------------------
# Falls back to DEPLOYER_PRIVATE_KEY, then CRANK_PRIVATE_KEY.
BENCH_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# waitlist + faucet (optional — both degrade gracefully)
# ---------------------------------------------------------------------------
# Upstash Redis over REST. Without it the waitlist counts in-process and says so.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any random string. IPs are hashed with this before being stored, so the rate
# limiter never keeps a raw address.
IP_HASH_SALT=
# Optional in-app faucet. Funded separately, capped daily, one drip per address
# ever. Unset and /api/faucet returns a 503 pointing at faucet.monad.xyz.
FAUCET_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# indexer (optional — powers history, leaderboard, referrals)
# ---------------------------------------------------------------------------
DATABASE_URL=
# Start indexing from here instead of the current head.
INDEX_FROM_BLOCK=

# ---------------------------------------------------------------------------
# supabase (optional — the hosted backend for waitlist/referral persistence)
# ---------------------------------------------------------------------------
# The anon key is public by design and safe in the browser bundle. The service
# role key is NOT: it bypasses row-level security. Server-side only, never
# prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Guards /admin and the kill switch. Any long random string.
ADMIN_SECRET=

# ---------------------------------------------------------------------------
# OKX x402 payments (optional — the paid-ASP path)
# ---------------------------------------------------------------------------
# Settlement runs on X Layer (chain 196), NOT on Monad. This is a separate
# chain from the market itself and wants its own key.
OKX_PAYMENT_TOKEN=
OKX_PAYMENT_NETWORK=196
OKX_FACILITATOR_URL=https://www.okx.com/web3/build/ai
ASP_PRICE_USDT=0.01
ASP_FEE_BPS=1200
# NEVER a key with real funds. Separate from every Monad key above.
SETTLEMENT_PRIVATE_KEY=
SETTLEMENT_CHAIN_ID=196
SETTLEMENT_RPC=https://rpc.xlayer.tech
SETTLEMENT_EXPLORER=https://www.oklink.com/xlayer

# On-chain x402 verification. Payments are proven by reading the ERC-20
# Transfer log of the claimed tx: the token must be X402_VERIFY_TOKEN, sent to
# X402_VERIFY_RECIPIENT, for at least the quoted amount.
X402_VERIFY_RPC=https://rpc.xlayer.tech
X402_VERIFY_CHAIN_ID=196
X402_VERIFY_TOKEN=
X402_VERIFY_RECIPIENT=

# ---------------------------------------------------------------------------
# LLM (optional — task planning and vision)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
