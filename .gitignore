# foundry
packages/contracts/out/
packages/contracts/cache/
packages/contracts/broadcast/
# forge-std is committed as plain files so a fresh clone builds without
# `git submodule update` — do not add lib/ here.

# env: every key in the project is loaded from here and none of it belongs in git.
# Ignore every .env variant and allow back only the committed template, so a
# .env.production or a hurried .env.backup cannot be staged by accident.
.env*
!.env.example

# indexer
apps/indexer/drizzle/meta/_journal.json.bak

# build output / logs
*.tsbuildinfo
*.log
npm-debug.log*
.DS_Store

# python bytecode from the reference model
__pycache__/
*.pyc

# benchmark artefacts are regenerated by `npm run bench`
bench-results-*.json

# ephemeral: local anvil addresses change every run
packages/contracts/deployments/31337.json
